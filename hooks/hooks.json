{
  "description": "cliffhanger: block the end of a turn while the checklist has open items or the last message is an early stop",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/cliffhanger.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/cliffhanger.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
